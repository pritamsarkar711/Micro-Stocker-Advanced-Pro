# ---------------------------------------------------------------------------
# Micro Stocker Advanced Pro - environment template
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is git-ignored: NEVER commit real keys.
#
# NOTE: everything prefixed with VITE_ is bundled into the renderer, so only
# put PUBLIC values here (Supabase URL + anon key are public by design).
# NEVER put a `service_role` key here - that one belongs in Supabase Edge
# Functions / a server, not in a desktop app.
#
# You can also skip this file entirely and enter the URL + anon key at runtime
# inside the app:  Settings > Cloud connection.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: show a "cloud" badge by default in dev
VITE_APP_ENV=development

# Central licensing backend (PUBLIC project URL and anon/publishable key only).
# These values are baked into official builds. Never include service role keys.
VITE_LICENSE_SUPABASE_URL=
VITE_LICENSE_SUPABASE_ANON_KEY=
