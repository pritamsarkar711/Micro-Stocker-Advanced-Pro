{
  "name": "micro-stocker-advanced-pro",
  "productName": "Micro Stocker Advanced Pro",
  "private": true,
  "version": "1.0.0",
  "description": "All-in-one desktop toolkit for microstock contributors: metadata generation, keywording, per-platform CSV export, IPTC/XMP embedding, local AI upscaling to 8K, validation, releases, submission planning and earnings analytics for 10 marketplaces.",
  "author": "pritamsarkar711",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "extract-zip": "^2.0.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.15.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "wait-on": "^9.5.1"
  },
  "keywords": [
    "microstock",
    "stock-photography",
    "metadata",
    "keywords",
    "iptc",
    "xmp",
    "csv-export",
    "shutterstock",
    "adobe-stock",
    "freepik",
    "magnific",
    "pixabay",
    "dreamstime",
    "123rf",
    "depositphotos",
    "vecteezy",
    "getty-images",
    "alamy",
    "image-upscaling",
    "real-esrgan",
    "electron",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/pritamsarkar711/Micro-Stocker-Advanced-Pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pritamsarkar711/Micro-Stocker-Advanced-Pro.git"
  },
  "bugs": {
    "url": "https://github.com/pritamsarkar711/Micro-Stocker-Advanced-Pro/issues"
  }
}
