{
  "name": "micro-stocker-advanced-pro",
  "productName": "Micro Stocker Advanced Pro",
  "private": false,
  "version": "2.3.0",
  "description": "Cross platform microstock contributor studio for AI metadata generation, lossless IPTC and XMP embedding, per agency CSV export across 14 marketplaces, open source image and video upscaling, background removal and multi format image conversion.",
  "author": {
    "name": "pritamsarkar711",
    "url": "https://github.com/pritamsarkar711"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs && node tests/pro-platform-db.mjs && node scripts/ssr-smoke.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "pack": "npm run build && electron-builder --config electron-builder.yml --dir",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --config electron-builder.yml --win",
    "dist:linux": "npm run build && electron-builder --config electron-builder.yml --linux",
    "dist:mac": "npm run build && electron-builder --config electron-builder.yml --mac",
    "postinstall": "electron-builder install-app-deps || true",
    "test:browser": "node scripts/browser-tests.mjs",
    "qa:contrast": "node scripts/qa/contrast.mjs",
    "qa:vector": "node scripts/qa/vector-check.mjs",
    "qa:layout": "node scripts/qa/audit-layout.mjs",
    "qa:a11y": "node scripts/qa/a11y-audit.mjs",
    "qa:deep": "node scripts/qa/deep-audit.mjs",
    "qa:interaction": "node scripts/qa/interaction-audit.mjs",
    "qa:security": "node scripts/qa/security-rules.mjs && node scripts/qa/security-check.mjs",
    "qa:suggest": "node scripts/qa/suggest-check.mjs",
    "qa:text": "node scripts/qa/text-check.mjs",
    "qa:tools": "node scripts/qa/tools-audit.mjs",
    "qa:mobile": "node scripts/qa/mobile-audit.mjs",
    "qa:launch": "node scripts/qa/launch-flow.mjs",
    "qa:all": "npm run qa:deep && npm run qa:a11y && npm run qa:contrast && npm run qa:interaction && npm run qa:text && npm run qa:suggest && npm run qa:vector && npm run qa:security && npm run qa:tools && npm run qa:mobile && npm run qa:launch",
    "qa:generate": "node scripts/qa/generate-samples.mjs",
    "build:web": "vite build",
    "android:sync": "npm run build:web && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@cornerstonejs/codec-openjpeg": "^1.3.6",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jxl": "^1.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "ag-psd": "^34.2.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "heic-to": "^1.6.7",
    "jpeg-js": "^0.4.4",
    "libheif-js": "^1.23.5",
    "libraw-wasm": "^1.6.0",
    "lucide-react": "^1.73.0",
    "onnxruntime-web": "^1.31.1",
    "pako": "^3.0.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "utif2": "^4.1.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@electric-sql/pglite": "^0.5.16",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^22.20.5",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "wait-on": "^9.5.1"
  },
  "keywords": [
    "123rf",
    "adobe-stock",
    "alamy",
    "canva",
    "csv-export",
    "depositphotos",
    "dreamstime",
    "electron",
    "envato-elements",
    "freepik",
    "getty-images",
    "image-upscaling",
    "iptc",
    "keywords",
    "magnific",
    "metadata",
    "microstock",
    "pixabay",
    "pond5",
    "react",
    "real-esrgan",
    "shutterstock",
    "stock-footage",
    "stock-photography",
    "typescript",
    "vecteezy",
    "vectorstock",
    "xmp"
  ],
  "homepage": "https://github.com/pritamsarkar711/Micro-Stocker-Advanced-Pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pritamsarkar711/Micro-Stocker-Advanced-Pro.git"
  },
  "bugs": {
    "url": "https://github.com/pritamsarkar711/Micro-Stocker-Advanced-Pro/issues"
  },
  "build": {
    "appId": "com.pritamsarkar.microstocker.advancedpro",
    "productName": "Micro Stocker Advanced Pro",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
